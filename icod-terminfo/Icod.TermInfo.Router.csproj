<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<LangVersion>13.0</LangVersion>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<AssemblyName>icod-terminfo</AssemblyName>
		<RootNamespace>Icod.TermInfo.Router</RootNamespace>
		<Configurations>Debug;Release;Staging</Configurations>
		<Version>$(IcodTermInfoSuiteVersion)</Version>
	</PropertyGroup>

	<PropertyGroup>
		<PackageVersion>$(IcodTermInfoSuiteVersion)</PackageVersion>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>icod-terminfo</ToolCommandName>
		<PackageId>Icod.TermInfo.Tools</PackageId>
		<Title>Icod.TermInfo Tools</Title>
		<Authors>Timothy J. Bruce</Authors>
		<Description>Installable .NET tool router for the managed Icod.TermInfo tic, infocmp, toe, captoinfo, and infotocap commands.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageProjectUrl>https://github.com/uniblab/Icod.TermInfo</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/uniblab/Icod.TermInfo</RepositoryUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>1.15.0 adds reviewed explicit hashed-file acquisition for infocmp -A/-B and human toe operands while preserving the five-command router, frozen JSON routes, installed-tool validation, six-RID archive topology, and conventional tic publication and ambient discovery semantics.</PackageReleaseNotes>
		<PackageTags>captoinfo;cli;command-line;console;cross-platform;csharp;dotnet;icod;infocmp;infotocap;libtinfo;termcap;terminal;termcaps;terminal-capabilities;terminfo;tic;toe;tool;tui;text-ui</PackageTags>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(PlatformTarget)' == '' ">
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\tic\Icod.TermInfo.Tic.csproj" />
		<ProjectReference Include="..\infocmp\Icod.TermInfo.InfoCmp.csproj" />
		<ProjectReference Include="..\toe\Icod.TermInfo.Toe.csproj" />
		<ProjectReference Include="..\captoinfo\Icod.TermInfo.CapToInfo.csproj" />
		<ProjectReference Include="..\infotocap\Icod.TermInfo.InfoToCap.csproj" />
	</ItemGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>2</WarningLevel>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Staging' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>3</WarningLevel>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>TRACE</DefineConstants>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<DebugType>portable</DebugType>
		<Optimize>true</Optimize>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\icon.png" Link="icon.png" Pack="true" PackagePath="" />
		<Content Include="README.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>$(AssemblyName).README.md</TargetPath>
			<Pack>true</Pack>
			<PackagePath>\</PackagePath>
		</Content>
		<Content Include="..\LICENSE">
			<Link>LICENSE</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>$(AssemblyName).LICENSE.txt</TargetPath>
			<Pack>true</Pack>
			<PackagePath>\</PackagePath>
		</Content>
	</ItemGroup>
</Project>
