<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<NuGetAudit>false</NuGetAudit>
		<IcodTermInfoTermcapPackageVersion Condition="'$(IcodTermInfoTermcapPackageVersion)' == ''">0.0.0-local-validation-required</IcodTermInfoTermcapPackageVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Icod.TermInfo.Termcap" Version="$(IcodTermInfoTermcapPackageVersion)" />
	</ItemGroup>
</Project>
