<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <IcodTermInfoPackageVersion Condition="'$(IcodTermInfoPackageVersion)' == ''">0.0.0-local-validation-required</IcodTermInfoPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Icod.TermInfo" Version="$(IcodTermInfoPackageVersion)" />
  </ItemGroup>
</Project>
