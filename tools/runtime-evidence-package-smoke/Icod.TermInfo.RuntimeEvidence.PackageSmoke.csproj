<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<NuGetAudit>false</NuGetAudit>
		<IcodTermInfoInspectionPackageVersion Condition="'$(IcodTermInfoInspectionPackageVersion)' == ''">0.0.0-local-validation-required</IcodTermInfoInspectionPackageVersion>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Icod.TermInfo.Inspection" Version="$(IcodTermInfoInspectionPackageVersion)" />
		<PackageReference Include="Icod.Terminal" Version="1.12.0" />
	</ItemGroup>
</Project>
