<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <IcodTermInfoSourcePackageVersion Condition="'$(IcodTermInfoSourcePackageVersion)' == ''">0.0.0-local-validation-required</IcodTermInfoSourcePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Icod.TermInfo.Source" Version="$(IcodTermInfoSourcePackageVersion)" />
  </ItemGroup>
</Project>
