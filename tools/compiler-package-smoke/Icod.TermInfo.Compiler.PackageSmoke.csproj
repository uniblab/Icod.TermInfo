<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<NuGetAudit>false</NuGetAudit>
		<IcodTermInfoCompilerPackageVersion Condition="'$(IcodTermInfoCompilerPackageVersion)' == ''">0.0.0-local-validation-required</IcodTermInfoCompilerPackageVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Icod.TermInfo.Compiler" Version="$(IcodTermInfoCompilerPackageVersion)" />
	</ItemGroup>
</Project>